			# right shifting axi_awaddr and axi_araddr to cache_bram_cachecontroller_v2 since it is word (4 byte word) addressable 
			["MODULE:cache_bram_cachecontroller_v2:a:axi_araddr", "CUSTOM:cache_bram_cachecontroller_v2_right_shift_by_2_with_0_concat_axi_araddr"],
