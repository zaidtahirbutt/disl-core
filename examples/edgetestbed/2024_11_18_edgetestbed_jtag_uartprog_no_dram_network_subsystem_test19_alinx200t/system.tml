		# 	INTERFACE = ""
		
		[[INTERCONNECT.DYNAMIC."MODULE:eth_nic:m_eth".GROUPS]]
			INTERCONNECT_TYPE = "ONE_TO_ONE"
			INTERFACE = "MODULE:cache_bram_cachecontroller_v2:a"

