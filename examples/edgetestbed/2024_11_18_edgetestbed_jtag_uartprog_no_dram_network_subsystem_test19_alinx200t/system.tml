[DESCRIPTION]
# Copied from "2024_11_18_edgetestbed_jtag_uartprog_no_dram_network_subsystem_test16_alinx200t"
# 12 VeBPF and parameterized VeBPF DEPTH of 2048

# this name should be the same as the example project folder name
NAME = "2024_11_18_edgetestbed_jtag_uartprog_no_dram_network_subsystem_test19_alinx200t"

[REQUIREMENTS]
TOOLS = ["pyjtag"]
BOARDS = ["alinx_ax7a200t"]

[EXTERNAL_IO]
PORTS = ["sys_clk_p", "sys_clk_n", "sys_rst_n", "uart_tx","uart_rx", "phy_reset_n", "phy_rx_ctl", "phy_rx_clk", "phy_rxd", "phy_tx_clk", "phy_tx_ctl", "phy_txd"]
# PORTS = ["sys_clk_p", "sys_clk_n", "sys_rst_n", "uart_tx","uart_rx", "pci_exp_txp", "pci_exp_txn", "pci_exp_rxp", "pci_exp_rxn", "phy_reset_n", "phy_rx_ctl", "phy_rx_clk", "phy_rxd", "phy_tx_clk", "phy_tx_ctl", "phy_txd"]


[INSTANTIATIONS]
	[INSTANTIATIONS.clk_200mhz_ibufgds_inst]
		MODULE = "IBUFGDS"
	[INSTANTIATIONS.clk_mmcm_eth_rgmmi_inst]
		MODULE = "clk_mmcm_eth_rgmmi"
	[INSTANTIATIONS.clk_bufg_inst]
		MODULE = "BUFG"
	[INSTANTIATIONS.clk90_bufg_inst]
		MODULE = "BUFG"
	[INSTANTIATIONS.sync_reset_inst]
		MODULE = "sync_reset"
	[INSTANTIATIONS.vio_0_sw_leds_inst]
		MODULE = "vio_0_sw_leds"
	# [INSTANTIATIONS.cache]
	# 	MODULE = "bram"
	# 	PARAMETERS.MEMORY_SIZE = 256
	[INSTANTIATIONS.gpio]
		MODULE = "gpio_axi"
		PARAMETERS.NUM_SWITCHES = 4
		PARAMETERS.NUM_LEDS = 4
	[INSTANTIATIONS.timer]
		MODULE = "timer_axi"
		# 125 MHz sys clk used taken from MMCM 
		PARAMETERS.CLOCK_FREQ_MHZ = 125
	[INSTANTIATIONS.debug]
		MODULE = "uart_axi"
		# 125 MHz sys clk used taken from MMCM
		PARAMETERS.CLOCK_FREQ_MHZ = 125
		PARAMETERS.UART_BAUD_RATE_BPS = 1000000
		PARAMETERS.DATA_WIDTH = 32
	# [INSTANTIATIONS.i2cbus]
	# 	MODULE = "i2c_axi"
	# 	PARAMETERS.CLOCK_FREQ_MHZ = 100
	[INSTANTIATIONS.rand_mod]
		MODULE = "random_module"
	# [INSTANTIATIONS.chip_manager]
	# 	MODULE = "jtag_chip_manager"
	# [INSTANTIATIONS.programmer]
	# 	MODULE = "progloader_axi"
	# 	PARAMETERS.CLOCK_FREQ_MHZ = 100
	# 	PARAMETERS.UART_BAUD_RATE_BPS = 921600
	[INSTANTIATIONS.progloader_v2]
		MODULE = "progloader_riscv_vebpf_v2"
		# 125 MHz sys clk used taken from MMCM
		PARAMETERS.CLOCK_FREQ_MHZ = 125
		PARAMETERS.UART_BAUD_RATE_BPS = 1000000
		PARAMETERS.SIMULATION = 0
		PARAMETERS.DATA_WIDTH = 32
		PARAMETERS.VEBPF_PROG_ADDRESS_WIDTH = 12
		PARAMETERS.VEBPF_PROG_DATA_WIDTH = 64
		PARAMETERS.VEBPF_PROG_DATA_BYTES = 8
		PARAMETERS.MEM_ADDR_SIZE = 32
	[INSTANTIATIONS.softcore_memory_bus_arbiter]
		MODULE = "softcore_memory_bus_grant"
		PARAMETERS.SIMULATION = 0
	[INSTANTIATIONS.cache_bram_cachecontroller_v2]
		MODULE = "bram_axi_cachecontroller_v2"
		# 524288 bits (64 kB)
		PARAMETERS.MEM_SIZE_BITS = 524288
		# 2^16 = 65,536 bytes memory
		PARAMETERS.ADDR_WIDTH = 16
		PARAMETERS.DATA_WIDTH = 32
	[INSTANTIATIONS.eth_nic]
		MODULE  = "eth_nic_1g_rgmmi"
		PARAMETERS.SIMULATION = 0
		PARAMETERS.AXI_DATA_WIDTH = 32
		PARAMETERS.AXI_ADDRESS_WIDTH = 32
		PARAMETERS.VEBPF_PROG_ADDRESS_WIDTH = 12
		PARAMETERS.VEBPF_PROG_DATA_WIDTH = 64
		PARAMETERS.VEBPF_PROG_DATA_BYTES = 8
		PARAMETERS.NUMBER_OF_VEBPF = 12
		PARAMETERS.VEBPF_PROG_ADDRESS_WIDTH_REDUCED = 11
	# [INSTANTIATIONS.clk_wiz_eth]
	# 	MODULE = "clk_wiz_ethernet_phy"
	 
	# so riscv linker and reset handler are populated by MAP fileds of the riscv address map in the system.tml file. The cache depth is not translated to the linker or reset handler.
	# the user has to manually specify cache depth separately and has to make sure that the cache depth/memory length of the riscv address map can fit into the cache (bram, etc) being
	# instantiated separately.
	[INSTANTIATIONS.cpu]
		MODULE = "picorv32_axi"
		ARCH = "rv32i"
		ABI = "ilp32"
		CROSS = "riscv32-unknown-elf-"
		CROSSCFLAGS = "-O3 -Wno-int-conversion -ffreestanding -nostdlib"
		CROSSLDFLAGS = "-ffreestanding -nostdlib  -Wl,-M"
		LINKER_REQUIREMENTS = ["muldi3.S", "div.S", "riscv-asm.h"]
		MEMORY = "cache"
		PARAMETERS.ENABLE_INTERRUPTS = 0
		PARAMETERS.ENABLE_PCPI = 1
		PARAMETERS.INSTRUCTION_MEMORY_STARTING_ADDRESS = 0
		PARAMETERS.INTERRUPT_HANDLER_STARTING_ADDRESS = 16
		# This is what determines the rest_handler stack pointer
		# 32 kB => [INSTANTIATIONS.cpu.MAP.cache] => LENGTH = "0x00040000"
			# NOPE WRONG. 32 kB => 32768 bytes => 0x8000 bytes
			# 0x40000 bytes = 256 kB as per cache memory address
		# PARAMETERS.INSTRUCTION_AND_DATA_MEMORY_SIZE_BYTES = 32768 
		# Changing inst and data mem to 64 kB as well
		PARAMETERS.INSTRUCTION_AND_DATA_MEMORY_SIZE_BYTES = 65536 
			# So this is going to the PicoRV hw as a paramter input to the parameter
			# "STACKADDR" of picorv32_axi module but we don't get an error since the 
			# linker script allocates the stack pointer to a higher value of 256 kB instead of
			# 32 kB as stated above.... but ideally these two should be the same imo 
		# changing LENGTH for cache to "0x10000" from "0x40000"
		[INSTANTIATIONS.cpu.MAP]
			[INSTANTIATIONS.cpu.MAP.cache]
				ORIGIN = "0x00000000"
				LENGTH = "0x00010000"
			[INSTANTIATIONS.cpu.MAP.gpio]
				ORIGIN = "0x10000000"
				LENGTH = "0x00000004"
			[INSTANTIATIONS.cpu.MAP.debug]
				ORIGIN = "0x10000018"
				LENGTH = "0x00000004"
			[INSTANTIATIONS.cpu.MAP.timer]
				ORIGIN = "0x1000001C"
				LENGTH = "0x00000004"
			[INSTANTIATIONS.cpu.MAP.eth_nic]
				ORIGIN = "0x20000000"
				LENGTH = "0x01900000"

# All constant numbers must be strings for the remaining system


[INTRINSICS]
	# [[INTRINSICS.ASSIGNMENT]]
	# 	CUSTOM_SIGNAL_WIDTH = 1
	# 	CUSTOM_SIGNAL_NAME = "CUSTOM:sw0_reset"
	# 	INPUT_SIGNAL =  "MODULE:vio_0_sw_leds_inst:sw0"
	# 	SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:sw1"
		INPUT_SIGNAL =  "MODULE:vio_0_sw_leds_inst:sw1"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:reprogram_vebpf"
		INPUT_SIGNAL =  "MODULE:vio_0_sw_leds_inst:sw2"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_arvalid"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_arvalid"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_arready"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_arready"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_rvalid"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_rvalid"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_rready"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_rready"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_awvalid"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_awvalid"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_awready"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_awready"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_wvalid"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_wvalid"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_wready"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_wready"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 4
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_wstrb"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_wstrb"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_b_ready"
		INPUT_SIGNAL =  "MODULE:cpu:mem:b_ready"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_b_valid"
		INPUT_SIGNAL =  "MODULE:cpu:mem:b_valid"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:clk_sys_125mhz"
		INPUT_SIGNAL =  "MODULE:clk_bufg_inst:O"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:clk_sys_125mhz_90shift"
		INPUT_SIGNAL =  "MODULE:clk90_bufg_inst:O"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:rst_mmcm"
		INPUT_SIGNAL =  "MODULE:sync_reset_inst:out"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT_MULTIBIT]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:cache_bram_cachecontroller_v2:ADDR_WIDTH - 2"
		CUSTOM_SIGNAL_NAME = "CUSTOM:cache_bram_cachecontroller_v2_right_shift_by_2_axi_araddr"
		INPUT_SIGNAL =  "MODULE:cache_bram_cachecontroller_v2:a:axi_araddr"
		SIGNAL_MSB = "PARAMETER:cache_bram_cachecontroller_v2:ADDR_WIDTH - 1"
		SIGNAL_LSB = "2"
	[[INTRINSICS.ASSIGNMENT_MULTIBIT]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:cache_bram_cachecontroller_v2:ADDR_WIDTH - 2"
		CUSTOM_SIGNAL_NAME = "CUSTOM:cache_bram_cachecontroller_v2_right_shift_by_2_axi_awaddr"
		INPUT_SIGNAL =  "MODULE:cache_bram_cachecontroller_v2:a:axi_awaddr"
		SIGNAL_MSB = "PARAMETER:cache_bram_cachecontroller_v2:ADDR_WIDTH - 1"
		SIGNAL_LSB = "2"
	# [[INTRINSICS.COMBINATIONAL]]
	# 	CUSTOM_SIGNAL_WIDTH = "PARAMETER:cache_bram_cachecontroller_v2:ADDR_WIDTH"
	# 	CUSTOM_SIGNAL_NAME = "CUSTOM:cache_bram_cachecontroller_v2_araddr"
	# 	INPUT_SIGNAL_1 =  "MODULE:cache_bram_cachecontroller_v2:a:axi_araddr"
	# 	OPERATION = ">>"
	# 	INPUT_SIGNAL_2 = "2"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:sw0_reset"
		INPUT_SIGNAL_1 =  "MODULE:vio_0_sw_leds_inst:sw0"
		OPERATION = "|"
		INPUT_SIGNAL_2 =  "CUSTOM:rst_mmcm"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:reprogram"
		INPUT_SIGNAL_1 =  "CUSTOM:sw1"
		OPERATION = "|"
		INPUT_SIGNAL_2 =  "MODULE:progloader_v2:busy"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:sw0_reset_or_reprogram"
		INPUT_SIGNAL_1 =  "CUSTOM:sw0_reset"
		OPERATION = "|"
		INPUT_SIGNAL_2 =  "CUSTOM:reprogram"
	# bitwise ^ with mask of 1 is bitwise not
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_resetn"
		INPUT_SIGNAL_1 =  "CUSTOM:sw0_reset_or_reprogram"
		OPERATION = "^"
		INPUT_SIGNAL_2 =  "1'd1"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:not_locked_clk_mmcm_eth_rgmmi_inst"
		INPUT_SIGNAL_1 =  "MODULE:clk_mmcm_eth_rgmmi_inst:locked"
		OPERATION = "^"
		INPUT_SIGNAL_2 =  "1'd1"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:not_cache_bram_cachecontroller_v2_a_axi_wready_out"
		INPUT_SIGNAL_1 =  "MODULE:cache_bram_cachecontroller_v2:a:axi_wready"
		OPERATION = "^"
		INPUT_SIGNAL_2 =  "1'd1"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_wvalid_and_wready"
		INPUT_SIGNAL_1 =  "MODULE:cpu:mem:axi_wvalid"
		OPERATION = "&"
		INPUT_SIGNAL_2 =  "MODULE:cpu:mem:axi_wready"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_wvalid_and_wready_resetn"
		INPUT_SIGNAL_1 =  "CUSTOM:cpu_mem_wvalid_and_wready"
		OPERATION = "&"
		INPUT_SIGNAL_2 =  "CUSTOM:cpu_resetn"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:gpio:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:gpio_a_axi_awaddr"
		INPUT_SIGNAL_1 =  "MODULE:gpio:a:axi_awaddr"
		OPERATION = "-"
		INPUT_SIGNAL_2 =  "SYSTEM:INSTANTIATIONS.cpu.MAP.gpio.ORIGIN"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:gpio:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:gpio_a_axi_araddr"
		INPUT_SIGNAL_1 =  "MODULE:gpio:a:axi_araddr"
		OPERATION = "-"
		INPUT_SIGNAL_2 =  "SYSTEM:INSTANTIATIONS.cpu.MAP.gpio.ORIGIN"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:debug:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:debug_a_axi_awaddr"
		INPUT_SIGNAL_1 =  "MODULE:debug:a:axi_awaddr"
		OPERATION = "-"
		INPUT_SIGNAL_2 =  "SYSTEM:INSTANTIATIONS.cpu.MAP.debug.ORIGIN"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:debug:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:debug_a_axi_araddr"
		INPUT_SIGNAL_1 =  "MODULE:debug:a:axi_araddr"
		OPERATION = "-"
		INPUT_SIGNAL_2 =  "SYSTEM:INSTANTIATIONS.cpu.MAP.debug.ORIGIN"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:timer:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:timer_a_axi_awaddr"
		INPUT_SIGNAL_1 =  "MODULE:timer:a:axi_awaddr"
		OPERATION = "-"
		INPUT_SIGNAL_2 =  "SYSTEM:INSTANTIATIONS.cpu.MAP.timer.ORIGIN"
	[[INTRINSICS.COMBINATIONAL]]
		"CUSTOM_SIGNAL_WIDTH" = "PARAMETER:timer:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:timer_a_axi_araddr"
		INPUT_SIGNAL_1 =  "MODULE:timer:a:axi_araddr"
		OPERATION = "-"
		INPUT_SIGNAL_2 =  "SYSTEM:INSTANTIATIONS.cpu.MAP.timer.ORIGIN"
	# [[INTRINSICS.COMBINATIONAL]]
	# 	CUSTOM_SIGNAL_WIDTH = "PARAMETER:i2cbus:ADDR_WIDTH"
	# 	CUSTOM_SIGNAL_NAME = "CUSTOM:i2cbus_a_axi_awaddr"
	# 	INPUT_SIGNAL_1 =  "MODULE:i2cbus:a:axi_awaddr"
	# 	OPERATION = "-"
	# 	INPUT_SIGNAL_2 =  "SYSTEM:INSTANTIATIONS.cpu.MAP.i2cbus.ORIGIN"
	# [[INTRINSICS.COMBINATIONAL]]
	# 	CUSTOM_SIGNAL_WIDTH = "PARAMETER:i2cbus:ADDR_WIDTH"
	# 	CUSTOM_SIGNAL_NAME = "CUSTOM:i2cbus_a_axi_araddr"
	# 	INPUT_SIGNAL_1 =  "MODULE:i2cbus:a:axi_araddr"
	# 	OPERATION = "-"
	# 	INPUT_SIGNAL_2 =  "SYSTEM:INSTANTIATIONS.cpu.MAP.i2cbus.ORIGIN"
	[[INTRINSICS.SEQUENTIAL_HOLD]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:cpu:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_axi_araddr"
		INTERNAL_SIGNAL_NAME = "INTERNAL:CUSTOM:cpu_axi_araddr"
		CUSTOM_SIGNAL_DEFAULT_VALUE = 0
		CLOCK = "MODULE:cpu:clk"
		TRIGGER = "MODULE:cpu:mem:axi_arvalid"
		HOLD_VALUE = "MODULE:cpu:mem:axi_araddr"
	[[INTRINSICS.SEQUENTIAL_HOLD]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:cpu:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_axi_awaddr"
		INTERNAL_SIGNAL_NAME = "INTERNAL:CUSTOM:cpu_axi_awaddr"
		CUSTOM_SIGNAL_DEFAULT_VALUE =  0
		CLOCK = "MODULE:cpu:clk"
		TRIGGER = "MODULE:cpu:mem:axi_awvalid"
		HOLD_VALUE = "MODULE:cpu:mem:axi_awaddr"
	# [[INTRINSICS.SEQUENTIAL_IFELSEIF]]
	# 	CUSTOM_SIGNAL_WIDTH = 1
	# 	CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_b_valid"
	# 	CUSTOM_SIGNAL_DEFAULT_VALUE =  0
	# 	CLOCK = "MODULE:cpu:clk"
	# 	CONDITION_1 = "CUSTOM:cpu_mem_wvalid_and_wready_resetn"
	# 	ASSIGNMENT_IF_CONDITION_1_TRUE = "1"
	# 	CONDITION_2 = "MODULE:cpu:mem:b_ready"
	# 	ASSIGNMENT_IF_CONDITION_2_TRUE = "0"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:gpio:NUM_LEDS"
		CUSTOM_SIGNAL_NAME = "CUSTOM:custom_led_assign_sw_and_gpio_sw"
		INPUT_SIGNAL_1 =  "CUSTOM:vio_4_bit_sw"
		OPERATION = "|"
		INPUT_SIGNAL_2 =  "MODULE:gpio:led"
	[[INTRINSICS.COMBINATIONAL]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:gpio:NUM_LEDS"
		CUSTOM_SIGNAL_NAME = "CUSTOM:custom_led_assign_random_mod_and_gpio_sw"
		INPUT_SIGNAL_1 =  "MODULE:rand_mod:four_bit_out"
		OPERATION = "|"
		INPUT_SIGNAL_2 =  "MODULE:gpio:led"
	[[INTRINSICS.CONCAT2]]
		CUSTOM_SIGNAL_WIDTH = 2
		CUSTOM_SIGNAL_NAME = "CUSTOM:cache_group_select_2bit_reprogram_with_mem_arbiter_select"
		SIGNAL_1 =  "CUSTOM:reprogram"
		SIGNAL_2 =  "MODULE:softcore_memory_bus_arbiter:mem_bus_group_sel"
	[[INTRINSICS.CONCAT2]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:cache_bram_cachecontroller_v2:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:cache_bram_cachecontroller_v2_right_shift_by_2_with_0_concat_axi_araddr"
		SIGNAL_1 =  "2'b0"
		SIGNAL_2 =  "CUSTOM:cache_bram_cachecontroller_v2_right_shift_by_2_axi_araddr"
	[[INTRINSICS.CONCAT2]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:cache_bram_cachecontroller_v2:ADDR_WIDTH"
		CUSTOM_SIGNAL_NAME = "CUSTOM:cache_bram_cachecontroller_v2_right_shift_by_2_with_0_concat_axi_awaddr"
		SIGNAL_1 =  "2'b0"
		SIGNAL_2 =  "CUSTOM:cache_bram_cachecontroller_v2_right_shift_by_2_axi_awaddr"
	[[INTRINSICS.CONCAT4]]
		CUSTOM_SIGNAL_WIDTH = "PARAMETER:gpio:NUM_SWITCHES"
		CUSTOM_SIGNAL_NAME = "CUSTOM:vio_4_bit_sw"
		SIGNAL_1 =  "MODULE:vio_0_sw_leds_inst:sw3"
		SIGNAL_2 =  "MODULE:vio_0_sw_leds_inst:sw2"
		SIGNAL_3 =  "MODULE:vio_0_sw_leds_inst:sw1"
		SIGNAL_4 =  "MODULE:vio_0_sw_leds_inst:sw0"

[INTERCONNECT]
	STATIC = [
				# clock connections and syncs
				["BOARD:sys_clk_p", "MODULE:clk_200mhz_ibufgds_inst:I"],
				["BOARD:sys_clk_n", "MODULE:clk_200mhz_ibufgds_inst:IB"],
				["MODULE:clk_200mhz_ibufgds_inst:O", "MODULE:clk_mmcm_eth_rgmmi_inst:clkin200mhz"],
				["MODULE:vio_0_sw_leds_inst:sw0", "MODULE:clk_mmcm_eth_rgmmi_inst:rst"],
				["MODULE:clk_mmcm_eth_rgmmi_inst:clkout125mhz", "MODULE:clk_bufg_inst:I"],
				["MODULE:clk_mmcm_eth_rgmmi_inst:clkout125mhz_90shift", "MODULE:clk90_bufg_inst:I"],
				["CUSTOM:clk_sys_125mhz", "MODULE:sync_reset_inst:clk"],
				["CUSTOM:not_locked_clk_mmcm_eth_rgmmi_inst", "MODULE:sync_reset_inst:rst"],
				# sys clk connections to soc peripherals
				["CUSTOM:clk_sys_125mhz", "MODULE:vio_0_sw_leds_inst:clk", "MODULE:debug:clk", "MODULE:softcore_memory_bus_arbiter:clk", "MODULE:eth_nic:clk", "MODULE:cpu:clk","MODULE:cache_bram_cachecontroller_v2:clk", "MODULE:timer:clk", "MODULE:gpio:clk","MODULE:progloader_v2:clk", "MODULE:rand_mod:clk"],
				["CUSTOM:clk_sys_125mhz_90shift", "MODULE:eth_nic:clk90"],
				["MODULE:eth_nic:phy_tx_clk", "BOARD:phy_tx_clk"],
