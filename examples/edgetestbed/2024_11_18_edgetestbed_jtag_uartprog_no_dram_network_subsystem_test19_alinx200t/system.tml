				# are connected normally. The b_ interfaces were simply left unconnected. 
			# Will have to connect b_ signals manually :\ Also check Sahanz implementation of AXIMML

			# ["MODULE:cpu:mem:b_valid","CUSTOM:cpu_mem_b_valid"],
