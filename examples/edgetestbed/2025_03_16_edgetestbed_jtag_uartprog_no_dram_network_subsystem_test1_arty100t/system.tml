[DESCRIPTION]
# This project is the same as "2024_10_3_edgetestbed_jtag_uartprog_no_dram_network_subsystem_test1_arty100t" but
# with the address map of DISLv1 for arty100t that I implemented the network functions on plus added the
# CLKsPerBiT to the ProgLoaderV2 in this for UART BAUD RATE BPS

# this name should be the same as the example project folder name
NAME = "2025_03_16_edgetestbed_jtag_uartprog_no_dram_network_subsystem_test1_arty100t"

[REQUIREMENTS]
TOOLS = ["pyjtag"]
BOARDS = ["artya7100t"]

[EXTERNAL_IO]
PORTS = ["clk_i","sw","led","uart_tx","uart_rx", "phy_reset_n", "phy_col", "phy_crs", "phy_rx_clk", "phy_rx_er", "phy_rx_dv", "phy_rxd", "phy_tx_clk", "phy_tx_en", "phy_txd", "phy_ref_clk"]


[INSTANTIATIONS]
	# [INSTANTIATIONS.cache]
	# 	MODULE = "bram"
	# 	PARAMETERS.MEMORY_SIZE = 256
	[INSTANTIATIONS.gpio]
		MODULE = "gpio_axi"
		PARAMETERS.NUM_SWITCHES = 4
		PARAMETERS.NUM_LEDS = 4
	[INSTANTIATIONS.timer]
		MODULE = "timer_axi"
		# 100 MHz is the original clk crystal freq of arty100t oscillator connected to pin E3
		PARAMETERS.CLOCK_FREQ_MHZ = 100
	[INSTANTIATIONS.debug]
		MODULE = "uart_axi"
		PARAMETERS.CLOCK_FREQ_MHZ = 100
		PARAMETERS.UART_BAUD_RATE_BPS = 1000000
		PARAMETERS.DATA_WIDTH = 32
	# [INSTANTIATIONS.i2cbus]
	# 	MODULE = "i2c_axi"
	# 	PARAMETERS.CLOCK_FREQ_MHZ = 100
	[INSTANTIATIONS.rand_mod]
		MODULE = "random_module"
	# [INSTANTIATIONS.chip_manager]
	# 	MODULE = "jtag_chip_manager"
	# [INSTANTIATIONS.programmer]
	# 	MODULE = "progloader_axi"
	# 	PARAMETERS.CLOCK_FREQ_MHZ = 100
	# 	PARAMETERS.UART_BAUD_RATE_BPS = 921600
	[INSTANTIATIONS.progloader_v2]
		MODULE = "progloader_riscv_vebpf_v2"
		PARAMETERS.CLOCK_FREQ_MHZ = 100
		PARAMETERS.UART_BAUD_RATE_BPS = 1000000
		PARAMETERS.SIMULATION = 0
		PARAMETERS.DATA_WIDTH = 32
		PARAMETERS.VEBPF_PROG_ADDRESS_WIDTH = 12
		PARAMETERS.VEBPF_PROG_DATA_WIDTH = 64
		PARAMETERS.VEBPF_PROG_DATA_BYTES = 8
		PARAMETERS.MEM_ADDR_SIZE = 32
	[INSTANTIATIONS.softcore_memory_bus_arbiter]
		MODULE = "softcore_memory_bus_grant"
		PARAMETERS.SIMULATION = 0
	[INSTANTIATIONS.cache_bram_cachecontroller_v2]
		MODULE = "bram_axi_cachecontroller_v2"
		# 524288 bits (64 kB)
		PARAMETERS.MEM_SIZE_BITS = 524288
		# 2^16 = 65,536 bytes memory
		PARAMETERS.ADDR_WIDTH = 16
		PARAMETERS.DATA_WIDTH = 32
	[INSTANTIATIONS.eth_nic]
		MODULE  = "eth_nic_100m_mmi"
		PARAMETERS.SIMULATION = 0
		PARAMETERS.AXI_DATA_WIDTH = 32
		PARAMETERS.AXI_ADDRESS_WIDTH = 32
		PARAMETERS.VEBPF_PROG_ADDRESS_WIDTH = 12
		PARAMETERS.VEBPF_PROG_DATA_WIDTH = 64
		PARAMETERS.VEBPF_PROG_DATA_BYTES = 8
	[INSTANTIATIONS.clk_wiz_eth]
		MODULE = "clk_wiz_ethernet_phy"
	# Going to keep the memory stack for riscv at 32 kB atm for the printf test
	# then will increment it to 64 kB as per the Bram_v2 memory
	 
	# so riscv linker and reset handler are populated by MAP fileds of the riscv address map in the system.tml file. The cache depth is not translated to the linker or reset handler.
	# the user has to manually specify cache depth separately and has to make sure that the cache depth/memory length of the riscv address map can fit into the cache (bram, etc) being
	# instantiated separately.
	[INSTANTIATIONS.cpu]
		MODULE = "picorv32_axi"
		ARCH = "rv32i"
		ABI = "ilp32"
		CROSS = "riscv32-unknown-elf-"
		CROSSCFLAGS = "-O3 -Wno-int-conversion -ffreestanding -nostdlib"
		CROSSLDFLAGS = "-ffreestanding -nostdlib  -Wl,-M"
		LINKER_REQUIREMENTS = ["muldi3.S", "div.S", "riscv-asm.h"]
		MEMORY = "cache"
		PARAMETERS.ENABLE_INTERRUPTS = 0
		PARAMETERS.ENABLE_PCPI = 1
		PARAMETERS.INSTRUCTION_MEMORY_STARTING_ADDRESS = 0
		PARAMETERS.INTERRUPT_HANDLER_STARTING_ADDRESS = 16
		# This is what determines the rest_handler stack pointer
		# 32 kB => [INSTANTIATIONS.cpu.MAP.cache] => LENGTH = "0x00040000"
			# NOPE WRONG. 32 kB => 32768 bytes => 0x8000 bytes
			# 0x40000 bytes = 256 kB as per cache memory address
		# PARAMETERS.INSTRUCTION_AND_DATA_MEMORY_SIZE_BYTES = 32768 
		# Changing inst and data mem to 64 kB as well
		PARAMETERS.INSTRUCTION_AND_DATA_MEMORY_SIZE_BYTES = 65536 
			# So this is going to the PicoRV hw as a paramter input to the parameter
			# "STACKADDR" of picorv32_axi module but we don't get an error since the 
			# linker script allocates the stack pointer to a higher value of 256 kB instead of
			# 32 kB as stated above.... but ideally these two should be the same imo 
		# changing LENGTH for cache to "0x10000" from "0x40000"
		[INSTANTIATIONS.cpu.MAP]
			[INSTANTIATIONS.cpu.MAP.cache]
				ORIGIN = "0x00000000"
				LENGTH = "0x00010000"
			[INSTANTIATIONS.cpu.MAP.gpio]
				ORIGIN = "0x10000000"
				LENGTH = "0x00000004"
			[INSTANTIATIONS.cpu.MAP.debug]
				ORIGIN = "0x10000018"
				LENGTH = "0x00000004"
			[INSTANTIATIONS.cpu.MAP.timer]
				ORIGIN = "0x1000001C"
				LENGTH = "0x00000004"
			[INSTANTIATIONS.cpu.MAP.eth_nic]
				ORIGIN = "0x20000000"
				LENGTH = "0x01900000"
# ---------------------------------------------------------------------------
# PREBUILD -- compile software as part of configuring the hardware, so one
# command builds both. Without this the firmware had to be built by hand first,
# and the choice of app and flags lived only in your shell history.
#
# Fields:
#   DIR      working directory for the command (${...} anchors expanded)
#   COMMAND  the executable; checked against PATH before running
#   ARGS     arguments passed through verbatim
#   VARS     appended as NAME=VALUE arguments -- which is how `make` takes
#            variables, so this is where the firmware's own build flags go
#   OPTIONAL what to do if the command is missing or fails (see below)
#
# Runs BEFORE anything is generated and BEFORE MEM_INIT resolves, so a system
# can compile its own firmware and then consume it in the same invocation.
#
# VARS is how this file selects firmware behaviour:
#   SIMULATION_TESTING = 1  suppress error printf() output (right for simulation)
#   DEBUG              = 1  compile in printf() error reporting as well as the
#                           error LED. Set this on a SYNTHESIS build to watch
#                           Ethernet packet processing over the debug UART on
#                           real hardware.
#
# OPTIONAL answers one question: if this step cannot run, should the build stop?
#   false -> hard failure.       Correct when something downstream needs the output.
#   true  -> warn and continue.  Correct when the output is a convenience, so
#                                someone with no RISC-V cross-toolchain can still
#                                generate and synthesize this design.
# The right answer depends on whether anything in THIS example consumes the
# firmware. Here it is true, because NOTHING here consumes it -- this example has no MEM_INIT. The
#             firmware is uploaded over UART AFTER the board is flashed, so the
#             bitstream never contains it. Building it just produces the
#             firmware.hex you will upload, which means synthesis needs no RISC-V
#             toolchain at all and the bitstream stays bit-identical to the
#             established benchmark.
#
# `configure.py --skip_prebuild` (or `vebpf-mc --skip-prebuild`) bypasses every
# step regardless. If a MEM_INIT then needs a missing output, that fails loudly
# with a clear message rather than silently simulating garbage.
[PREBUILD.riscv_firmware]
	DIR      = "${PROJECT_ROOT}/RISCV_C_FW_VebpfManyCore/fw/vebpf_network_packet_processing"
	COMMAND  = "make"
	ARGS     = ["APP=vebpf_firewall_syn"]
	VARS     = { SIMULATION_TESTING = 0, DEBUG = 0 }
	OPTIONAL = true
# ---------------------------------------------------------------------------
# ADDRESS_MAP_HEADER -- keep ONE address map, not two.
#
# The RISC-V address map has to be known in two places: the hardware (which
# disl-core generates from [INSTANTIATIONS.<INSTANCE>.MAP] below) and the C
# firmware (which has its own riscv_subsystem/config/address_map.h). Nothing
# used to connect them, so they could drift apart silently.
#
# MODE is the legacy-header vs generated-header choice:
#   "off"       do nothing. THE DEFAULT -- omit this whole section and nothing
#               changes, which is why existing examples are unaffected.
#   "check"     KEEP USING the legacy header at PATH, but verify it against the
#               hardware map. A macro defined on BOTH sides at DIFFERENT
#               addresses FAILS the build. An entry present on only ONE side is
#               a warning, because the C code may simply not use that peripheral
#               (see ETH_NIC below). Set STRICT = true to fail on those too.
#   "generate"  OVERWRITE the header at PATH from the MAP below, so the firmware
#               compiles against the hardware's map. This modifies that file in
#               its own repository's working tree, which is why it is not default.
#
# A copy always lands in <build_dir>/gen/address_map.h for provenance.
#
# NAMES maps a hardware MAP key to its C macro name, and is load-bearing rather
# than cosmetic: the MAP key `debug` would otherwise emit
# `#define DEBUG 0x10000018` and collide with the DEBUG build flag the firmware
# already uses. That address is the UART, which is what the C header has always
# called it. Watch for this when adding MAP keys named after common macros.
#
# EXTRA adds macros the C header needs that have no hardware MAP entry.
[ADDRESS_MAP_HEADER]
	MODE     = "check"
	STRICT   = false
	INSTANCE = "cpu"
	PATH     = "${PROJECT_ROOT}/RISCV_C_FW_VebpfManyCore/riscv_subsystem/config/address_map.h"
	[ADDRESS_MAP_HEADER.NAMES]
		cache   = "MEM"
		gpio    = "GPIO"
		debug   = "UART"
		timer   = "TIMER"
		eth_nic = "ETH_NIC"
	[ADDRESS_MAP_HEADER.EXTRA]
		CONFIG = "0x80000000"

# All constant numbers must be strings for the remaining system


[INTRINSICS]
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:sw0_reset"
		INPUT_SIGNAL =  "BOARD:sw"
		SIGNAL_BITS = "[0]"
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:sw1"
		INPUT_SIGNAL =  "BOARD:sw"
		SIGNAL_BITS = "[1]"
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:reprogram_vebpf"
		INPUT_SIGNAL =  "BOARD:sw"
		SIGNAL_BITS = "[2]"
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_arvalid"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_arvalid"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_arready"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_arready"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_rvalid"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_rvalid"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_rready"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_rready"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_awvalid"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_awvalid"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_awready"
		INPUT_SIGNAL =  "MODULE:cpu:mem:axi_awready"
		SIGNAL_BITS = ""
	[[INTRINSICS.ASSIGNMENT]]
		CUSTOM_SIGNAL_WIDTH = 1
		CUSTOM_SIGNAL_NAME = "CUSTOM:cpu_mem_axi_wvalid"
