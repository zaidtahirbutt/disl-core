	# MODULE:cpu dynamic connections defs
	[INTERCONNECT.DYNAMIC."MODULE:cpu:mem"]
		GROUP_SELECT = "CUSTOM:cache_group_select_2bit_reprogram_with_mem_arbiter_select"
		HANDSHAKES = ["WRITE_ADDRESS", "WRITE_DATA", "READ_ADDRESS", "READ_DATA", "WRITE_RESPONSE"]
		# TODO: Atm I am writing conditions for all values of the 2 bit select line. After first exp, I will comment out the conditions that arent being used and will see what happens (gets generated)
		[[INTERCONNECT.DYNAMIC."MODULE:cpu:mem".GROUPS]]
			INTERCONNECT_TYPE = "ONE_TO_MANY"
			SELECT_VALUE = 0
			ADDRESS_MAP = [
					"SYSTEM:INSTANTIATIONS.cpu.MAP.cache MODULE:cache_bram_cachecontroller_v2:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.gpio MODULE:gpio:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.debug MODULE:debug:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.timer MODULE:timer:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.eth_nic MODULE:eth_nic:s_eth",
			]
			# After reading DISL readme, I came to the conclusion that 
			# for WRITE_DATA and READ_DATA, CUSTOM:cpu_axi_awaddr is being
			# used as opposed to MODULE:cpu:mem:axi_awaddr being used
			# for WRITE_ADDRESS handshake, the reason is that for WRITE_DATA
			# or READ_DATA, it might take some time to write or read data (DDR might take longer than cache)
			# hence the custom signal CUSTOM:cpu_axi_awaddr is used for WRITE_DATA (and similar for READ_DATA)
			# since the write or read address needs to be held to the same value while the data is being 
			# written or read in the memory, but riscv has same address bus and the value on it changes 
			# after I believe it receives a ready for WIRE_ADDRESS operation and READ_ADDRESS operation
			# (that is why MODULE:cpu:mem:axi_awaddr is used directly for WRITE_ADDRESS since RISC-V 
			# will hold that address value till it gets a ready flag that the module at the other end
			# has "registered" the address). But same can not be said for WRITE_DATA or READ_DATA op
			# where address value has been registered already, but the handshake_map requires we give
			# it the same write or read address, this is where we use the intrinsic where these address
			# values are being held.
			
			# For WRITE_RESPONSE CUSTOM:cpu_axi_awaddr I am using this custom awaddr it is due to the same reason
			# that awaddr can change on the riscv side if it READING something else now while waiting for the write resp
			# and I believe the addr line is the same for reading and writing, hence we need to hold the writing address 
			# for this Write response
			HANDSHAKE_MAP = [
						"WRITE_ADDRESS MODULE:cpu:mem:axi_awaddr",
						"READ_ADDRESS MODULE:cpu:mem:axi_araddr",
						"WRITE_DATA CUSTOM:cpu_axi_awaddr",
						"READ_DATA CUSTOM:cpu_axi_araddr",
						"WRITE_RESPONSE CUSTOM:cpu_axi_awaddr"
			]
		[[INTERCONNECT.DYNAMIC."MODULE:cpu:mem".GROUPS]]
			INTERCONNECT_TYPE = "ONE_TO_MANY"
			SELECT_VALUE = 1
			ADDRESS_MAP = [
					"SYSTEM:INSTANTIATIONS.cpu.MAP.gpio MODULE:gpio:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.debug MODULE:debug:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.timer MODULE:timer:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.eth_nic MODULE:eth_nic:s_eth",
			]
			HANDSHAKE_MAP = [
						"WRITE_ADDRESS MODULE:cpu:mem:axi_awaddr",
						"READ_ADDRESS MODULE:cpu:mem:axi_araddr",
						"WRITE_DATA CUSTOM:cpu_axi_awaddr",
						"READ_DATA CUSTOM:cpu_axi_araddr",
						"WRITE_RESPONSE CUSTOM:cpu_axi_awaddr"
			]
		[[INTERCONNECT.DYNAMIC."MODULE:cpu:mem".GROUPS]]
			INTERCONNECT_TYPE = "ONE_TO_MANY"
			SELECT_VALUE = 2
			ADDRESS_MAP = [
					"SYSTEM:INSTANTIATIONS.cpu.MAP.gpio MODULE:gpio:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.debug MODULE:debug:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.timer MODULE:timer:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.eth_nic MODULE:eth_nic:s_eth",
			]
			HANDSHAKE_MAP = [
						"WRITE_ADDRESS MODULE:cpu:mem:axi_awaddr",
						"READ_ADDRESS MODULE:cpu:mem:axi_araddr",
						"WRITE_DATA CUSTOM:cpu_axi_awaddr",
						"READ_DATA CUSTOM:cpu_axi_araddr",
						"WRITE_RESPONSE CUSTOM:cpu_axi_awaddr"
			]
		[[INTERCONNECT.DYNAMIC."MODULE:cpu:mem".GROUPS]]
			INTERCONNECT_TYPE = "ONE_TO_MANY"
			# connect cpu with cache for select value of 3
			SELECT_VALUE = 3
			ADDRESS_MAP = [
					"SYSTEM:INSTANTIATIONS.cpu.MAP.cache MODULE:cache_bram_cachecontroller_v2:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.gpio MODULE:gpio:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.debug MODULE:debug:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.timer MODULE:timer:a",
					"SYSTEM:INSTANTIATIONS.cpu.MAP.eth_nic MODULE:eth_nic:s_eth",
			]
			HANDSHAKE_MAP = [
						"WRITE_ADDRESS MODULE:cpu:mem:axi_awaddr",
						"READ_ADDRESS MODULE:cpu:mem:axi_araddr",
						"WRITE_DATA CUSTOM:cpu_axi_awaddr",
						"READ_DATA CUSTOM:cpu_axi_araddr",
						"WRITE_RESPONSE CUSTOM:cpu_axi_awaddr"
			]
	
	# MODULE:cache_bram_cachecontroller_v2 dynamic connections defs	
	[INTERCONNECT.DYNAMIC."MODULE:cache_bram_cachecontroller_v2:a"]
		GROUP_SELECT = "CUSTOM:cache_group_select_2bit_reprogram_with_mem_arbiter_select"
		HANDSHAKES = ["WRITE_ADDRESS", "WRITE_DATA", "READ_ADDRESS", "READ_DATA", "WRITE_RESPONSE"]
		[[INTERCONNECT.DYNAMIC."MODULE:cache_bram_cachecontroller_v2:a".GROUPS]]
			SELECT_VALUE = 0
			INTERCONNECT_TYPE = "ONE_TO_ONE"
			INTERFACE = "MODULE:cpu:mem"
		[[INTERCONNECT.DYNAMIC."MODULE:cache_bram_cachecontroller_v2:a".GROUPS]]
			SELECT_VALUE = 1
			INTERCONNECT_TYPE = "ONE_TO_ONE"
			INTERFACE = "MODULE:eth_nic:m_eth"
		[[INTERCONNECT.DYNAMIC."MODULE:cache_bram_cachecontroller_v2:a".GROUPS]]
			SELECT_VALUE = 2
			INTERCONNECT_TYPE = "ONE_TO_ONE"
			INTERFACE = "MODULE:progloader_v2:a"
		[[INTERCONNECT.DYNAMIC."MODULE:cache_bram_cachecontroller_v2:a".GROUPS]]
			# connect with CPU for value for select value of 3
			SELECT_VALUE = 3
			INTERCONNECT_TYPE = "ONE_TO_ONE"
			INTERFACE = "MODULE:cpu:mem"


