[IO]
	[IO.sys_clk_p]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "CLOCK"
	[IO.sys_clk_n]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "CLOCK"
	[IO.sys_rst_n]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	# User switches and LEDs. Added so a simulation example can drive reset and
	# reprogram through real top-level ports, the way the artya7100t examples do.
	# The synthesis examples on this board use the vio_0_sw_leds VIO core instead
	# (a Vivado IP, and a black box to Icarus), which is why these did not exist.
	[IO.sw]
		DIRECTION = "SOURCE"
		WIDTH = 4
		INTERFACE_TYPE = "GENERAL"
	[IO.led]
		DIRECTION = "SINK"
		WIDTH = 4
		INTERFACE_TYPE = "GENERAL"
	[IO.uart_rx]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	[IO.uart_tx]
		DIRECTION = "SINK"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	# [IO.pci_exp_txp]
	# 	DIRECTION = "SINK"
	# 	WIDTH = 4
	# 	INTERFACE_TYPE = "GENERAL"
	# [IO.pci_exp_txn]
	# 	DIRECTION = "SINK"
	# 	WIDTH = 4
	# 	INTERFACE_TYPE = "GENERAL"
	# [IO.pci_exp_rxp]
	# 	DIRECTION = "SOURCE"
	# 	WIDTH = 4
	# 	INTERFACE_TYPE = "GENERAL"
	# [IO.pci_exp_rxn]
	# 	DIRECTION = "SOURCE"
	# 	WIDTH = 4
	# 	INTERFACE_TYPE = "GENERAL"
	[IO.phy_reset_n]
		DIRECTION = "SINK"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	[IO.phy_rx_ctl]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	[IO.phy_rx_clk]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "CLOCK"
	[IO.phy_rxd]
		DIRECTION = "SOURCE"
		WIDTH = 4
		INTERFACE_TYPE = "GENERAL"
	[IO.phy_tx_clk]
		DIRECTION = "SINK"
		WIDTH = 1
		INTERFACE_TYPE = "CLOCK"
	[IO.phy_tx_ctl]
		DIRECTION = "SINK"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	[IO.phy_txd]
		DIRECTION = "SINK"
		WIDTH = 4
		INTERFACE_TYPE = "GENERAL"


[CONSTRAINTS]
# sw / led carry NO pin assignments on purpose. This board file ships with the
# AX7A200T's documented pinout for every other port; the user keys and LEDs were
# never part of it, and inventing PACKAGE_PINs would silently drive whatever
# happens to be at those locations. A simulation needs no pins, so the SIM
# example works as-is; a SYNTHESIS build using these ports will fail loudly with
# unconstrained-port errors, which is the correct outcome -- add your board
# revision's pins here at that point.
sw = "# sw[3:0] intentionally unconstrained -- see the comment in board.tml [CONSTRAINTS]"
led = "# led[3:0] intentionally unconstrained -- see the comment in board.tml [CONSTRAINTS]"

### DIFFERENTIAL clk ##
# sys_clk_p = """
# set_property LOC IBUFDS_GTE2_X0Y3 [get_cells refclk_ibuf]
# create_clock -period 10.000 -name sys_clk [get_ports {sys_clk_p}] 
# """
# sys_clk_n = ""
sys_clk_p = """

# General configuration
set_property CFGBVS VCCO                               [current_design]
set_property CONFIG_VOLTAGE 3.3                        [current_design]
set_property BITSTREAM.GENERAL.COMPRESS true           [current_design]

# https://support.xilinx.com/s/question/0D52E00006lLh4gSAC/drc-lutlp1-combinatorial-loop-error-must-be-overridden?language=en_US
# ERROR: [DRC LUTLP-1] Combinatorial Loop Alert: 11 LUT cells form a combinatorial loop. This can create a race condition. Timing
# analysis may not be accurate.
set_property SEVERITY {Warning} [get_drc_checks LUTLP-1] 
set_property ALLOW_COMBINATORIAL_LOOPS TRUE


# set_property CFGBVS value1 [current_design]
#where value1 is either VCCO or GND
# set_property CONFIG_VOLTAGE value2 [current_design]
#where value2 is the voltage provided to configuration bank 0

# for DRC routing: https://support.xilinx.com/s/article/71074?language=en_US
resize_pblock [get_pblocks Stage1_cfgiob] -add {IOB_X0Y52:IOB_X0Y103}	

create_clock -period 5.000 [get_ports sys_clk_p]
set_property PACKAGE_PIN R4 [get_ports sys_clk_p]

"""
sys_clk_n = """

set_property PACKAGE_PIN T4 [get_ports sys_clk_n]
set_property IOSTANDARD DIFF_SSTL15 [get_ports sys_clk_n]

"""
# prev version
