phy_tx_ctl = """

set_property IOSTANDARD LVCMOS33 [get_ports phy_tx_ctl]
set_property SLEW FAST [get_ports phy_tx_ctl]
set_property PACKAGE_PIN N17 [get_ports phy_tx_ctl]

"""


