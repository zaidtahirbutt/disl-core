set_property PACKAGE_PIN P17 [get_ports {phy_rxd[3]}]
set_property PACKAGE_PIN U17 [get_ports {phy_rxd[2]}]
set_property PACKAGE_PIN U18 [get_ports {phy_rxd[1]}]
set_property PACKAGE_PIN P19 [get_ports {phy_rxd[0]}]


"""
