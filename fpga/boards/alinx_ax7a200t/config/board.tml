# set_false_path -from [get_ports sys_rst_n]
# """
sys_rst_n = """
set_property PACKAGE_PIN F15 [get_ports sys_rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports sys_rst_n]

set_false_path -from [get_ports {sys_rst_n}]
set_input_delay 0 [get_ports {sys_rst_n}]

"""
