################## Ethernet connections ###################################################################
# phy_resetn output port
phy_reset_n = """

set_property IOSTANDARD LVCMOS33 [get_ports phy_reset_n]
set_property PACKAGE_PIN R14 [get_ports phy_reset_n]
set_false_path -to [get_ports {phy_reset_n}]
set_output_delay 0 [get_ports {phy_reset_n}]

"""


# ETH phy_rx_ctl INPUT
phy_rx_ctl = """

set_property IOSTANDARD LVCMOS33 [get_ports phy_rx_ctl]
set_property PACKAGE_PIN R19 [get_ports phy_rx_ctl]

"""

# phy_rx_clk INPUT
phy_rx_clk = """

create_clock -period 8.000 [get_ports phy_rx_clk]
set_property IOSTANDARD LVCMOS33 [get_ports phy_rx_clk]
set_property PACKAGE_PIN V18 [get_ports phy_rx_clk]

"""

