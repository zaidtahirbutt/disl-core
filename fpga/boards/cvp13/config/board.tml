# Chip and board description
[DESCRIPTION]
NAME = "CVP13"
DIRECTORY = "cvp13"
CHIP_VENDOR = "xilinx"
BOARD_VENDOR = "Bittware"
FAMILY.SHORT = "xcu"
FAMILY.LONG = "Ultrascale+"
PART.SHORT = "xcvu13p_0"
PART.LONG = "xcvu13p-figd2104-2-e"

# include these files after the IPs have been generated. TCL generation script can figure out the path from build path
[REQUIREMENTS]
[REQUIREMENTS.FILES]
[REQUIREMENTS.FILES."jtag_phy.v"]
	HDL =[]
	IP = []
[REQUIREMENTS.FILES."ibufds_phy.v"]
	HDL =[]
	IP = []
[REQUIREMENTS.FILES."ddr.v"]
	HDL =["MTA8ATF51264AZ-2G3.csv"]
	IP = []

[REQUIREMENTS.IP]
	[REQUIREMENTS.IP."ddr.v"]
	ddr4_mig = """ 
		create_ip -name ddr4 -vendor xilinx.com -library ip -module_name ddr4_0
		set_property -dict [list CONFIG.C0.DDR4_TimePeriod {1250} CONFIG.C0.DDR4_InputClockPeriod {10000} CONFIG.C0.DDR4_CLKOUT0_DIVIDE {7} CONFIG.C0.DDR4_MemoryType {UDIMMs} CONFIG.C0.DDR4_MemoryPart {MTA8ATF51264AZ-2G3} CONFIG.C0.DDR4_DataWidth {64} CONFIG.C0.DDR4_CasLatency {16} CONFIG.C0.DDR4_CasWriteLatency {16} CONFIG.C0.DDR4_CustomParts {../../../../../MTA8ATF51264AZ-2G3.csv} CONFIG.C0.DDR4_isCustom {true}] [get_ips ddr4_0]
		generate_target {instantiation_template} [get_files ./$PROJECT/$PROJECT.srcs/sources_1/ip/ddr4_0/ddr4_0.xci]
		update_compile_order -fileset sources_1
	"""


[IO]
	[IO.clk_i_p]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "CLOCK"
	[IO.clk_i_n]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "CLOCK"
	[IO.ddr_clk_i_p]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "CLOCK"
	[IO.ddr_clk_i_n]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "CLOCK"
	[IO.uart_rx]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	[IO.uart_tx]
		DIRECTION = "SINK"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	[IO.led]
		DIRECTION = "SINK"
		WIDTH = 4
		INTERFACE_TYPE = "GENERAL"
	[IO.ddr]
		INTERFACE_TYPE = "DDR4"
		DIRECTION = "SINK"
		[IO.ddr.SIGNALS.reset_n]
			WIDTH  = 1
		[IO.ddr.SIGNALS.ck_c]
			WIDTH  = 1
		[IO.ddr.SIGNALS.ck_t]
			WIDTH  = 1
		[IO.ddr.SIGNALS.cke]
			WIDTH  = 1
		[IO.ddr.SIGNALS.cs_n]
			WIDTH  =1
		[IO.ddr.SIGNALS.act_n]
			WIDTH  = 1
		[IO.ddr.SIGNALS.dm]
			WIDTH  = 8
		[IO.ddr.SIGNALS.ba]
			WIDTH  = 2
		[IO.ddr.SIGNALS.bg]
			WIDTH  = 2
		[IO.ddr.SIGNALS.addr]
			WIDTH  = 17
		[IO.ddr.SIGNALS.dq]
			WIDTH  = 64
		[IO.ddr.SIGNALS.dqs_c]
			WIDTH  = 8
		[IO.ddr.SIGNALS.dqs_t]
			WIDTH  = 8
		[IO.ddr.SIGNALS.odt]
			WIDTH = 1
	[IO.fake_io_port]
		DIRECTION = "SOURCE"
		WIDTH = 1
		INTERFACE_TYPE = "GENERAL"
	

[CONSTRAINTS]
fake_io_port = """
set_property CONFIG_VOLTAGE 1.8 [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
set_property BITSTREAM.CONFIG.USR_ACCESS TIMESTAMP [current_design]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.CONFIG.SPI_32BIT_ADDR NO [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 85.0 [current_design]
set_property BITSTREAM.CONFIG.SPI_FALL_EDGE YES [current_design]
"""

clk_i_p = "set_property -dict { PACKAGE_PIN AV22    IOSTANDARD DIFF_SSTL18_I } [get_ports {clk_i_p}];"
clk_i_n = "set_property -dict { PACKAGE_PIN AV21    IOSTANDARD DIFF_SSTL18_I } [get_ports {clk_i_n}];"
ddr_clk_i_p = """
set_property IOSTANDARD DIFF_SSTL12_DCI [get_ports ddr_clk_i_p]
set_property IOSTANDARD DIFF_SSTL12_DCI [get_ports ddr_clk_i_n]
set_property ODT RTT_48 [get_ports ddr_clk_i_p]
set_property PACKAGE_PIN AY18 [get_ports ddr_clk_i_p]
set_clock_groups -group [get_clocks ddr_clk_i_p -include_generated_clocks] -asynchronous
"""
ddr_clk_i_n = ""
uart_tx = "set_property -dict { PACKAGE_PIN AT19   IOSTANDARD LVCMOS18 } [get_ports { uart_tx }];"
uart_rx = "set_property -dict { PACKAGE_PIN AT20    IOSTANDARD LVCMOS18 } [get_ports { uart_rx }];"

led = """
set_property -dict { PACKAGE_PIN AL21    IOSTANDARD LVCMOS18 } [get_ports { led[0] }];
set_property -dict { PACKAGE_PIN AL20    IOSTANDARD LVCMOS18 } [get_ports { led[1] }];
set_property -dict { PACKAGE_PIN AP21    IOSTANDARD LVCMOS18 } [get_ports { led[2] }];
set_property -dict { PACKAGE_PIN AP20    IOSTANDARD LVCMOS18 } [get_ports { led[3] }];
"""

ddr = """
