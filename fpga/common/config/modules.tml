	[timer_axi.INTERFACES.clk]
			TYPE = "CLOCK"
			DIRECTION = "SINK"
	[timer_axi.INTERFACES.rst]
			TYPE = "GENERAL"
			WIDTH = 1
			DIRECTION = "SINK"
