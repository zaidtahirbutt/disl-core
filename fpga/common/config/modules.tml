			TYPE = "CLOCK"
			DIRECTION = "SINK"
	[riscv_vector_extension.INTERFACES.rst]
			TYPE = "GENERAL"
			DIRECTION = "SINK"
			WIDTH = 1
	[riscv_vector_extension.INTERFACES.mem_request]
			TYPE = "GENERAL"
			DIRECTION = "SOURCE"
			WIDTH = 1
	[riscv_vector_extension.INTERFACES.pcpi]
			TYPE = "PCPI"
			DIRECTION = "SINK"
			CLOCK = "clk"
			WORD_WIDTH = 32
	[riscv_vector_extension.INTERFACES.pcpi_passthrough]
			TYPE = "PCPI"
			DIRECTION = "SOURCE"
			CLOCK = "clk"
			WORD_WIDTH = 32
	[riscv_vector_extension.INTERFACES.cache]
