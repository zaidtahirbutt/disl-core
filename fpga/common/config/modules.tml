	TYPES = ["COMPUTE"]
	PARAMETERS = ["ENABLE_PCPI_PASSTHROUGH", "XLEN", "CACHE_WORD_SIZE", "CACHE_ADDR_SIZE", "VLEN", "ENABLE_SEW_8", "ALU_UNITS_SEW_8", "ENABLE_SEW_8_ALU_ADD", "ENABLE_SEW_8_ALU_SUB", "ENABLE_SEW_8_ALU_MUL", "ENABLE_SEW_8_ALU_SLL", "ENABLE_SEW_8_ALU_SRL", "ENABLE_SEW_16", "ALU_UNITS_SEW_16", "ENABLE_SEW_16_ALU_ADD", "ENABLE_SEW_16_ALU_SUB", "ENABLE_SEW_16_ALU_MUL", "ENABLE_SEW_16_ALU_SLL", "ENABLE_SEW_16_ALU_SRL", "ENABLE_SEW_32", "ALU_UNITS_SEW_32", "ENABLE_SEW_32_ALU_ADD", "ENABLE_SEW_32_ALU_SUB", "ENABLE_SEW_32_ALU_MUL", "ENABLE_SEW_32_ALU_SLL", "ENABLE_SEW_32_ALU_SRL", "ENABLE_SEW_64", "ALU_UNITS_SEW_64", "ENABLE_SEW_64_ALU_ADD", "ENABLE_SEW_64_ALU_SUB", "ENABLE_SEW_64_ALU_MUL", "ENABLE_SEW_64_ALU_SLL", "ENABLE_SEW_64_ALU_SRL", "ENABLE_CSRRS_RW_VSTART", "ENABLE_CSRRS_RW_VSXSAT", "ENABLE_CSRRS_RW_VXRM", "ENABLE_CSRRS_RW_VCSR", "ENABLE_CSRRS_RW_VL", "ENABLE_CSRRS_RW_VTYPE", "ENABLE_CSRRS_RW_VLENB", "ENABLE_VSETVL", "ENABLE_VSETVLI", "ENABLE_VSETIVLI", "ENABLE_VL_WHOLE_REGISTER", "ENABLE_VS_WHOLE_REGISTER", "ENABLE_VL_UNIT_STRIDE", "ENABLE_VS_UNIT_STRIDE", "ENABLE_VL_STRIDED", "ENABLE_VS_STRIDED", "ENABLE_VL_INDEX_UNORDERED", "ENABLE_VS_INDEX_UNORDERED", "ENABLE_VL_INDEX_ORDERED", "ENABLE_VS_INDEX_ORDERED", "ENABLE_INTEGER_VECTOR_VECTOR_ADD", "ENABLE_FLOATINGPOINT_VECTOR_VECTOR_ADD"]
	[riscv_vector_extension.REQUIREMENTS]
		INTERFACES = ["clk", "rst", "pcpi", "pcpi_passthrough", "cache", "mem_request"]
		[riscv_vector_extension.REQUIREMENTS.INCLUDES]
			COMMON = ["riscv_vector_extension.v"]
			BOARD = []
			COMMON_FOLDER = []
			USE_SPECIFIC_FILES_FROM_COMMON_FOLDER = []
			COMMON_FOLDER_FILES = []
