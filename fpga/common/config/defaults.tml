		IN6_ADDRESS_OFFSET = 0
		IN7_ADDRESS_OFFSET = 0
		#1MB mask
		IN0_ADDRESS_MASK = 16777215
		IN1_ADDRESS_MASK = 16777215
		IN2_ADDRESS_MASK = 16777215
		IN3_ADDRESS_MASK = 16777215
		IN4_ADDRESS_MASK = 16777215
		IN5_ADDRESS_MASK = 16777215
		IN6_ADDRESS_MASK = 16777215
		IN7_ADDRESS_MASK = 16777215
	[MODULES.aximml_address_translation]
		ADDR_WIDTH = 32
		NUMBER_OF_MEMORY_REGIONS = 3
	[MODULES.pcpi_delay]
		OPCODE = 43
	[MODULES.fp32units_pcpi]
		OPCODE = 43
	[MODULES.riscv_vector_extension]
		ENABLE_PCPI_PASSTHROUGH = 0
		XLEN = 32
		CACHE_WORD_SIZE = 32
		CACHE_ADDR_SIZE = 32
		VLEN = 2048
